rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- Helper Functions ---
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/employee_profiles/$(request.auth.token.email)).data;
    }

    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.get('email', '').matches('.*@mdjescalejeunesse\\.ca$') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'STAFF', 'VOLUNTEER'])
      );
    }

    function isHardcodedAdmin() {
      return isAuthenticated() && 
        (request.auth.token.get('email', '') == 'gestion@mdjescalejeunesse.ca' || 
         request.auth.token.get('email', '') == 'dg@mdjescalejeunesse.ca');
    }

    function isAdmin() {
      return isHardcodedAdmin() || (isAuthenticated() && 
        (getUserData().role == 'admin' || getUserData().role == 'super_admin'));
    }

    // --- Collections ---

    // Users Collection (Website Profiles)
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isStaff();
    }

    // Registrations subcollection under users
    match /users/{userId}/registrations/{registrationId} {
      allow read, write: if isOwner(userId) || isStaff();
    }

    // Collection Group: registrations
    match /{path=**}/registrations/{registrationId} {
      allow read: if isStaff();
    }

    // Sync profiles (Fallback / Backward compatibility)
    match /sync_youth_profiles/{docId} {
      allow read, delete: if isStaff();
    }

    // Inscriptions Web
    match /web_registrations/{registrationId} {
      allow create: if true;
      allow read, update, delete: if isStaff();
    }

    // Logs quotidiens pour synchronisation
    match /sync_daily_logs/{docId} {
      allow read, write: if isStaff();
    }

    // Thématiques mensuelles
    match /themes/{themeId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Configurations globales
    match /settings/{docId} {
      allow read, write: if isStaff();
    }

    // Profils employés
    match /employee_profiles/{email} {
      allow read: if isStaff();
      allow write: if isAdmin() || (isAuthenticated() && request.auth.token.email == email);
    }

    // Inventaire & Achats
    match /inventory_items/{itemId} {
      allow read, write: if isStaff();
    }

    match /purchase_requests/{requestId} {
      allow read, write: if isStaff();
      allow delete: if isAdmin();
    }

    match /material_reservations/{reservationId} {
      allow read, write: if isStaff();
    }

    // Registre interne PSSOC (Membres locaux)
    match /members/{memberId} {
      allow read, write: if isStaff();
    }

    // Partenaires personnalisés
    match /custom_partners/{partnerId} {
      allow read, write: if isStaff();
    }

    // Activités du planificateur
    match /activities/{activityId} {
      allow read: if true; // Public read pour le calendrier
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
      );
    }

    // Activités publiques du site web
    match /web_activities/{activityId} {
      allow read: if true;
      allow create, delete: if isStaff();
      allow update: if isStaff() || (
        isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registeredCount'])
      );
    }

    // Transactions
    match /transactions/{transactionId} {
      allow read, write: if isStaff();
    }

    // Site Configuration
    match /site_config/{docId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Gouvernance & CA (Direction uniquement)
    match /board_members/{boardMemberId} {
      allow read, write: if isAdmin();
    }
    match /vault_documents/{docId} {
      allow read, write: if isAdmin();
    }

    // Santé Financière
    match /financial_health/{docId} {
      allow read, write: if isAdmin();
    }

    // Messagerie interne
    match /messages/{messageId} {
      allow read, write: if isStaff();
    }

    // Jetons de notification
    match /user_tokens/{email} {
      allow read, write: if isAuthenticated() && request.auth.token.email == email;
    }

    // Site web content fallback collections
    match /hero/{docId} { allow read: if true; allow write: if isStaff(); }
    match /gallery/{docId} { allow read: if true; allow write: if isStaff(); }
    match /team_staff/{docId} { allow read: if true; allow write: if isStaff(); }
    match /team_board/{docId} { allow read: if true; allow write: if isStaff(); }
    match /partners_list/{docId} { allow read: if true; allow write: if isStaff(); }
    match /parents_info/{docId} { allow read: if true; allow write: if isStaff(); }
    match /emergency/{docId} { allow read: if true; allow write: if isStaff(); }
    match /documents/{docId} { allow read: if true; allow write: if isStaff(); }
    match /about_overview/{docId} { allow read: if true; allow write: if isStaff(); }
    match /history_timeline/{docId} { allow read: if true; allow write: if isStaff(); }
    match /contact_info/{docId} { allow read: if true; allow write: if isStaff(); }
    match /calendar_config/{docId} { allow read: if true; allow write: if isStaff(); }
    match /about_impact/{docId} { allow read: if true; allow write: if isStaff(); }
    match /about_testimonials/{docId} { allow read: if true; allow write: if isStaff(); }
  }
}
